

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum Role {
  TENANT
  LANDLORD
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}
enum PropertyType {
  HOUSE
  APARTMENT
  CONDO
  VILLA
  STUDIO
  DUPLEX
  PENTHOUSE
}
enum PropertyStatus {
  AVAILABLE
  UNAVAILABLE
  RENTED
}
model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  password     String
  phone        String?
  role         Role
  status       UserStatus @default(ACTIVE)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  
  properties      Property[] 
  rentalRequests  RentalRequest[]

  @@map("users")
}

model Property {
  id            String         @id @default(uuid())
  title         String
  description   String
  type          PropertyType
  status        PropertyStatus @default(AVAILABLE)

  price         Decimal        @db.Decimal(10, 2)
  location      String
  address       String
  city          String
  bedrooms      Int
  bathrooms     Int
  areaSqft      Int?
  amenities     String[]       @default([])
  images        String[]       @default([])

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  landlordId    String
  landlord      User            @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  rentalRequests RentalRequest[]

  @@index([landlordId])
  @@index([city])
  @@index([status])
  @@map("properties")
}

enum RentalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
model RentalRequest {
  id            String               @id @default(uuid())
  status        RentalRequestStatus  @default(PENDING)
  moveInDate    DateTime
  moveOutDate   DateTime?
  message       String?

  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  // Relations
  tenantId      String
  tenant        User        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  propertyId    String
  property      Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  

  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@map("rental_requests")
}